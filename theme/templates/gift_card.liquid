{%- comment -%}
  Gift card. Unlike every other template here this one cannot be JSON — Shopify
  renders it outside the section system, so it is Liquid or nothing. That is why
  it does not use main-stub like the rest.

  Unported: the design has no gift card screen, and inventing one would be
  inventing a product the studio does not sell. This renders the card's real data
  and nothing else until there is a design to follow.
{%- endcomment -%}

<section class="mx-auto max-w-content px-gutter py-section text-center">
  <p class="text-micro uppercase tracking-eyebrow text-ink-subtle">{{ shop.name }}</p>

  <h1 class="mt-3 font-display text-h1">{{ 'gift_card.issued.title' | t }}</h1>

  <p class="mt-6 font-display text-display" data-numeric>
    {{ gift_card.balance | money }}
  </p>

  <div class="mx-auto mt-block w-full max-w-md rounded-sm bg-canvas p-8">
    {{ gift_card.qr_identifier }}
    <p class="mt-4 text-label uppercase tracking-nav text-ink-muted" data-numeric>
      {{ gift_card.code | format_code }}
    </p>
  </div>

  {%- if gift_card.expires_on -%}
    <p class="mt-6 text-caption text-ink-muted">
      {{ 'gift_card.issued.expires' | t: expiry: gift_card.expires_on | date: format: 'date' }}
    </p>
  {%- endif -%}

  <a
    href="{{ shop.url }}"
    class="mt-block inline-flex min-h-11 items-center rounded-sm bg-brand px-8 text-label uppercase tracking-label text-on-brand transition-colors duration-(--duration-base) hover:bg-brand-hover"
  >
    {{ 'gift_card.issued.shop_link' | t }}
  </a>
</section>
