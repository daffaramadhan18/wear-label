{%- comment -%}
  Not found. Port of app/not-found.tsx.

  Kept deliberately plain: the number, the line, one way back. An earlier pass
  added a body paragraph and a second link to search, and that was more page
  than a 404 needs.

  EVERY SLOT IS GUARDED, and the body one matters: `copy` draws a labelled
  placeholder when its value is blank, which is right on a page whose layout
  depends on the missing thing and wrong here. Blank a setting and its element
  is not drawn at all.

  The button is `snippets/button.liquid`. This section used to retype the
  primary button's class string, which is what that snippet was extracted to
  stop.
{%- endcomment -%}

{%- assign shop_href = routes.all_products_collection_url -%}

<div class="mx-auto w-full max-w-content px-gutter">
  <div class="flex flex-col items-center gap-5 py-section text-center">
    <p class="text-micro uppercase tracking-eyebrow text-ink-subtle" data-numeric>404</p>

    {%- if section.settings.heading != blank -%}
      <h1 class="font-display text-h1 leading-h1 text-ink">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="wl-measure text-small text-ink-muted">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- if section.settings.cta != blank -%}
      <div class="mt-2">
        {% render 'button', label: section.settings.cta, href: shop_href, variant: 'primary' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "paragraph", "content": "The page a reader lands on when a link is dead. Blank any field and that element is not drawn." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "textarea", "id": "body", "label": "Body", "info": "Optional. Blank by default: the heading says enough." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Back to shop" }
  ]
}
{% endschema %}
