  "name": "Customer voices",
  "max_blocks": 40,
  "settings": [
    {
      "type": "paragraph",
      "content": "Real Shopee reviews, verbatim. Never edit, tidy, translate or invent one — this section is allowed where a star rating is not precisely because it quotes customers instead of manufacturing a score. Keep the count a multiple of four or the last column runs short."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From our customers"
    }
  ],
  "blocks": [
    {
